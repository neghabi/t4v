generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

model AdminAccount {
  id String @id @db.VarChar(24)
  username String @unique @db.VarChar(64)
  passwordHash String @map("password_hash") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  @@map("admin_accounts")
}

model User {
  id           String         @id @db.VarChar(24)
  email        String         @unique @db.VarChar(320)
  passwordHash String         @map("password_hash") @db.Text
  credits      Int            @default(0)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  emailVerifiedAt DateTime?   @map("email_verified_at")
  sessions     Session[]
  links        ShortLink[]
  ledger       CreditLedger[]
  apiKeys      ApiKey[]
  topUps       CreditTopUp[]
  actionTokens AuthActionToken[]
  payments Payment[]

  @@map("users")
}

model CreditTopUp {
  id               String    @id @db.VarChar(24)
  userId           String    @map("user_id") @db.VarChar(24)
  requestedCredits Int       @map("requested_credits")
  status           String    @default("pending") @db.VarChar(16)
  createdAt        DateTime  @default(now()) @map("created_at")
  reviewedAt       DateTime? @map("reviewed_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Asc)])
  @@map("credit_top_ups")
}

model ApiKey {
  id         String    @id @db.VarChar(24)
  userId     String    @map("user_id") @db.VarChar(24)
  name       String    @db.VarChar(80)
  keyPrefix  String    @map("key_prefix") @db.VarChar(16)
  keyHash    String    @unique @map("key_hash") @db.Char(64)
  lastUsedAt DateTime? @map("last_used_at")
  scopes String[] @default(["links:read", "links:write"])
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("api_keys")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.VarChar(24)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String? @map("user_agent") @db.VarChar(512)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ShortLink {
  code         String      @id @db.VarChar(32)
  userId       String      @map("user_id") @db.VarChar(24)
  url          String      @db.Text
  title        String      @default("") @db.VarChar(120)
  tags         String[]    @default([])
  requestKey   String?     @unique @map("request_key") @db.Char(64)
  requestSignature String? @map("request_signature") @db.Char(64)
  passwordHash String?     @map("password_hash") @db.Text
  expiresAt    DateTime?   @map("expires_at")
  clickCount   Int         @default(0) @map("click_count")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks       LinkClick[]
  pendingClicks ClickEvent[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("short_links")
}

model LinkClick {
  id        BigInt    @id @default(autoincrement())
  linkCode  String    @map("link_code") @db.VarChar(32)
  clickedAt DateTime  @default(now()) @map("clicked_at")
  referer   String?   @db.Text
  userAgent String?   @map("user_agent") @db.Text
  ipHash    String?   @map("ip_hash") @db.Char(64)
  eventId   String?   @unique @map("event_id") @db.VarChar(24)
  link      ShortLink @relation(fields: [linkCode], references: [code], onDelete: Cascade)

  @@index([linkCode, clickedAt(sort: Desc)])
  @@index([clickedAt])
  @@map("link_clicks")
}

model AuthActionToken {
  tokenHash String @id @map("token_hash") @db.Char(64)
  userId String @map("user_id") @db.VarChar(24)
  kind String @db.VarChar(16)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("auth_action_tokens")
}

model ClickEvent {
  id String @id @db.VarChar(24)
  linkCode String @map("link_code") @db.VarChar(32)
  clickedAt DateTime @default(now()) @map("clicked_at")
  referer String? @db.Text
  userAgent String? @map("user_agent") @db.Text
  ipHash String? @map("ip_hash") @db.Char(64)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  link ShortLink @relation(fields: [linkCode], references: [code], onDelete: Cascade)
  @@index([availableAt])
  @@map("click_events")
}

model Payment {
  id String @id @db.VarChar(24)
  userId String @map("user_id") @db.VarChar(24)
  credits Int
  amount Int
  currency String @default("IRR") @db.VarChar(3)
  provider String @default("sandbox") @db.VarChar(24)
  status String @default("pending") @db.VarChar(16)
  requestKey String @unique @map("request_key") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  paidAt DateTime? @map("paid_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt(sort: Desc)])
  @@map("payments")
}

model CreditLedger {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(24)
  delta     Int
  reason    String   @db.VarChar(240)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("credit_ledger")
}

model RateLimit {
  key       String   @id @db.Char(64)
  scope     String   @db.VarChar(48)
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("rate_limits")
}
